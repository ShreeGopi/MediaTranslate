# Keep generated or machine-managed files out of GitHub language stats.
package-lock.json linguist-generated=true

# Local runtime folders should not affect language detection if they are ever committed.
TL-backend/** linguist-vendored
backend/uploads/** linguist-generated=true
uploads/** linguist-generated=true

# Make sure the main app code is classified clearly.
*.js linguist-language=JavaScript
*.html linguist-language=HTML
*.css linguist-language=CSS
